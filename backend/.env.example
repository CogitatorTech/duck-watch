PORT="8080"
LOG_LEVEL="debug"
LOG_PRETTY="true"
CORS_ORIGINS="*"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"
DATABASE_MAX_CONNECTIONS="5"
DATABASE_ACQUIRE_TIMEOUT_SECONDS="10"
SESSION_TTL_HOURS="720"
# Base64 encoded 32-byte key that encrypts stored MotherDuck tokens. There is
# deliberately no default: a shared key would mean every installation could
# decrypt every other one's tokens. `make run-backend` generates one when it
# creates your .env, or make your own with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
INGEST_POLL_INTERVAL_SECONDS="60"
INGEST_OVERLAP_MINUTES="15"
INGEST_BATCH_LIMIT="5000"
INGEST_BACKFILL_LIMIT="1000"
# MotherDuck recomputes storage every one to six hours, so reading it more
# often than that only adds cost.
INGEST_STORAGE_INTERVAL_SECONDS="3600"
